
NEXT_PUBLIC_APP_NAME=Emarath

NEXT_PUBLIC_APP_ENV=development

NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api

# Google Maps JavaScript API key for the GPS Map (GPS-05.1).
# Put your real key in .env.local (git-ignored, and Next.js loads it ahead of
# .env.development) — never in .env.development, which is committed.
# The key must have the "Maps JavaScript API" enabled and billing active on its
# project; a key Google rejects falls back to the demo key, which renders a blank
# map and logs "Maps Demo Key limit reached".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
